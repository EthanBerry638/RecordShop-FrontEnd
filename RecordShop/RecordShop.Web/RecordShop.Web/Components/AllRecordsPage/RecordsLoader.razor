@using System.Text.Json
@using System.Text.Json.Serialization
@using Models;
@using Services;
@inject IAlbumService _albumService

@if(getAlbumsError)
{
    <p>Failed to load record data. Please try again later.</p>
}
else if (albums == null)
{
    <h2>Fetching Data...</h2>
    <Spinner Color="SpinnerColor.Primary" />
}
else
{
    <RecordSummaryList Albums="@albums.ToList()"></RecordSummaryList>
}

@code {
    private IEnumerable<Album>? albums = null;
    private bool getAlbumsError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Task.Delay(2000);

            var response = await _albumService.GetAllAlbumsAsync();

            if (response != null)
            {
                albums = response;
            }
            else
            {
                getAlbumsError = true;
            }
        }
        catch (Exception)
        {
            getAlbumsError = true;
        }
    }
}