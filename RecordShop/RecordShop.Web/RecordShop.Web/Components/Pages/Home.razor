@using System.Text.Json;
@using Models;

@page "/"

<PageTitle>Home - Off The Record</PageTitle>

<main class="home-container">
    <header>
        <h1>Welcome to Off The Record</h1>
        <p>Music Inventory & Collection Management</p>
    </header>

    <hr />

    <section class="hero-section">
        <div class="hero-text">
            <p>
                Welcome to your central hub for tracking and managing your music inventory. This application is designed to catalog album details, monitor stock levels, and organize your collection efficiently.
            </p>
            <p>
                Use the navigation menu on the left to browse the full catalogue of records, view detailed item entries, or add new additions to your shop's inventory!
            </p>
        </div>

        <div class="hero-image">
            <img src="vinyls.jpg" alt="Vinyl Records Collection" />
        </div>
    </section>

    <hr />

    <section class="features">
        <h2>App Capabilities</h2>
        <ul>
            <li><strong>Live Catalogue:</strong> Search, filter, and view every record currently in stock.</li>
            <li><strong>Inventory Management:</strong> Seamlessly add new albums to your inventory.</li>
            <li><strong>Stock Control:</strong> Monitor quantities so you never run out of your best-selling vinyl.</li>
        </ul>
    </section>
</main>