@using System.Text.Json;
@using Models;

@page "/"

<PageTitle>Home - Off The Record</PageTitle>

<main class="container my-4">
    <header class="mb-4">
        <h1 class="display-5 fw-bold">Welcome to Off The Record</h1>
        <p class="lead text-muted">Music Inventory & Collection Management</p>
    </header>

    <hr class="my-4" />

    <section class="row align-items-center g-4">
        <div class="col-md-7">
            <p>
                Welcome to your central hub for tracking and managing your music inventory. This application is designed to catalog album details, monitor stock levels, and organize your collection efficiently.
            </p>
            <p>
                Use the navigation menu on the left to browse the full catalogue of records, view detailed item entries, or add new additions to your shop's inventory!
            </p>
        </div>

        <div class="col-md-5 text-center">
            <img src="Vinyls.jpg" alt="Vinyl Records Collection" class="img-fluid rounded shadow-sm" />
        </div>
    </section>

    <hr class="my-4" />

    <section class="mb-4">
        <h2 class="h3 mb-3">App Capabilities</h2>
        <ul class="list-group list-group-flush max-width-md">
            <li class="list-group-item ps-0"><strong>Live Catalogue:</strong> Search, filter, and view every record currently in stock.</li>
            <li class="list-group-item ps-0"><strong>Inventory Management:</strong> Seamlessly add new albums to your inventory.</li>
            <li class="list-group-item ps-0"><strong>Stock Control:</strong> Monitor quantities so you never run out of your best-selling vinyl.</li>
        </ul>
    </section>
</main>