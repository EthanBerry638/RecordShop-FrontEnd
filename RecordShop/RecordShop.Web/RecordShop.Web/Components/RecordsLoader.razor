@using System.Text.Json
@using System.Text.Json.Serialization
@using Models;
@inject HttpClient Http

@if(getAlbumsError)
{
    <p>Failed to load record data. Please try again later.</p>
}
else if (albums == null)
{
    <h2>Fetching Data...</h2>
    <Spinner Color="SpinnerColor.Primary" />
}
else
{
    <RecordSummaryList Albums="@albums.ToList()"></RecordSummaryList>
}

@code {
    private IEnumerable<Album>? albums = null;
    private bool getAlbumsError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<Album>>($"https://localhost:7091/api/Album");

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            if (response != null)
            {
                albums = response;
            }
            else
            {
                getAlbumsError = true;
            }
        }
        catch (Exception)
        {
            getAlbumsError = true;
        }
    }
}