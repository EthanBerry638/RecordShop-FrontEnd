@using Models;
@rendermode InteractiveServer
@inject HttpClient Http

<h3>Enter Details Below To Add A Record</h3>

<EditForm Model="Album" OnValidSubmit="HandleSave" FormName="AddAlbumForm">

    <DataAnnotationsValidator></DataAnnotationsValidator>
    <ValidationSummary></ValidationSummary>

    <div>
        <label>
            Title:
            <input type="text" @bind-value="Album!.Title"/>
        </label>
    </div>

    <div>
        <label>
            Description:
            <input type="text" @bind-value="Album!.Description" />
        </label>
    </div>

    <div>
        <label>
            Release Date:
            <input type="date" @bind-value="Album.ReleaseDate" />
        </label>
    </div>

    <div>
        <label>
            Price:
            <input type="number" @bind-value="Album.Price" />
        </label>
    </div>

    <div>
        <button type="submit">Click to save changes</button>
    </div>

</EditForm>

@code {
    [SupplyParameterFromForm]
    private Album? Album { get; set; }

    private string? errorMessage = null;

    protected override void OnInitialized()
    {
        Album ??= new();
    }

    private async Task HandleSave()
    {
        try
        {
            if (Album != null)
            {
                var response = await Http.PostAsJsonAsync("https://localhost:7091/api/Album", Album);

                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "Failed to add album. Please try again later";
                }
            }
        }
        catch (Exception)
        {
            errorMessage = "Failed to add album. Please try again later";
        }
    }
}
