@using Models;
@rendermode InteractiveServer

<h3>Enter Details Below To Add A Record</h3>

<EditForm Model="Album">
    
    <div>
        <label>
            Title:
        </label>
    </div>

    <div>
        <label>
            Description:
        </label>
    </div>

    <div>
        <label>
            Release Date:
        </label>
    </div>

    <div>
        <label>
            Price:
        </label>
    </div>

    <div>
        <button type="submit">Click to save changes</button>
    </div>

</EditForm>

@code {
    [SupplyParameterFromForm]
    private Album? Album { get; set; }
}
