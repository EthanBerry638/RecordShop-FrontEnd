@using Models;
@using Services;
@using RecordShop.Web.Components.Shared;
@inject NavigationManager _navigationManager
@inject IAlbumService _albumService
@rendermode InteractiveServer

@if (isSaved)
{
    <h3>Success! @Album!.Title saved successfully:</h3>
    <RecordSummary Album="Album" />
    <p>Navigating back to records...</p>
}
else if (postError)
{
    <p>There was an error saving the record. Please try again.</p>
}
else if (isProcessing)
{
    <p>Saving record @Album!.Title...</p>
    <Spinner Color="SpinnerColor.Primary"/>
}
else
{
    <h3>Enter Details Below To Add A Record</h3>

    <EditForm Model="Album" OnValidSubmit="HandleSave" FormName="AddAlbumForm">

        <DataAnnotationsValidator></DataAnnotationsValidator>
        <ValidationSummary></ValidationSummary>

        <div>
            <label>
                Title:
                <input type="text" @bind-value="Album!.Title"/>
            </label>
        </div>

        <div>
            <label>
                Description:
                <input type="text" @bind-value="Album!.Description" />
            </label>
        </div>

        <div>
            <label>
                Release Date:
                <input type="date" @bind-value="Album.ReleaseDate" />
            </label>
        </div>

        <div>
            <label>
                Price:
                <input type="number" @bind-value="Album.Price" />
            </label>
        </div>

        <div>
            <button type="submit">Click to save changes</button>
        </div>

    </EditForm>
}

@code {
    [SupplyParameterFromForm]
    private Album? Album { get; set; }

    private bool postError = false;
    private bool isProcessing = false;
    private bool isSaved = false;

    protected override void OnInitialized()
    {
        Album ??= new();
    }

    private async Task HandleSave()
    {
        isProcessing = true;
        postError = false;
        isSaved = false;

        if (Album != null)
        {
            try
            {
                await _albumService.AddAlbumAsync(Album);

                postError = false;
                isProcessing = false;
                isSaved = true;
                StateHasChanged();
                await Task.Delay(2000);
                _navigationManager.NavigateTo("/records");
            }
            catch(Exception)
            {
                postError = true;
                isProcessing = false;
            }
        }
        else
        {
            postError = true;
            isProcessing = false;
        }
    }
}
