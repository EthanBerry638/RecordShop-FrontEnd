@using Models;
@using Services;
@inject IAlbumService _albumService
@inject NavigationManager _navigationManager
@rendermode InteractiveServer

@if (showConfirmation)
{
    <DeleteConfirmation ConfirmChange="ResolveDeletion"></DeleteConfirmation>
}
else if (isNavigating)
{
    <p>Success! Navigating back to records page...</p>
}
else
{
    <button @onclick="InitialiseDeletion">🗑️</button>
}

@if (!isDeleted && isClicked && !showConfirmation)
{
    <p>Failed to delete. Please try again later or refresh</p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool showConfirmation = false;
    private bool isDeleted = false;
    private bool isClicked = false;
    private bool isNavigating = false;

    private void InitialiseDeletion()
    {
        showConfirmation = true;
    }

    private async Task ResolveDeletion(bool confirmed)
    {
        showConfirmation = false;

        if (confirmed)
        {
            isClicked = true;
            try
            {
                await _albumService.DeleteAlbumAsync(Id);
                isDeleted = true;
                isNavigating = true;

                StateHasChanged();

                await Task.Delay(2000);

                _navigationManager.NavigateTo("/records");
            }
            catch (Exception)
            {
                isDeleted = false;
                isNavigating = false;
            }
        }
        else
        {
            isClicked = false;
            isDeleted = false;
            isNavigating = false;
        }
    }
}