@using Models;
@using Services;
@inject IAlbumService _albumService
@rendermode InteractiveServer

<button @onclick="InitialiseDeletion">🗑️</button>

@if (showConfirmation)
{
    <DeleteConfirmation ConfirmChange="ResolveDeletion"></DeleteConfirmation>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private bool showConfirmation = false;

    private void InitialiseDeletion()
    {
        showConfirmation = true;
    }

    private async Task ResolveDeletion(bool confirmed)
    {
        showConfirmation = false;

        if (confirmed)
        {
            try
            {
                await _albumService.DeleteAlbumAsync(id);
            }
            catch (Exception)
            {
            }
        }
    }
}