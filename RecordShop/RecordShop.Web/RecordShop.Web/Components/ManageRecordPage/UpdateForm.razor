@using Models
@using Services
@using RecordShop.Web.Components.Shared
@inject IAlbumService _albumService
@rendermode InteractiveServer

@if (AlbumToUpdate != null)
{
    <EditForm Model="AlbumToUpdate" OnValidSubmit="HandleSave" FormName="EditAlbumForm">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

        <div>
            <label>
                Title: 
                <InputText @bind-Value="AlbumToUpdate.Title"/>
            </label>
        </div>

        <div>
            <label>
                Description:
                <InputText @bind-Value="AlbumToUpdate.Description" />
            </label>
        </div>

        <div>
            <label>
                Release Date:
                <InputDate @bind-Value="AlbumToUpdate.ReleaseDate" />
            </label>
        </div>

        <div>
            <label>
                Price:
                <InputNumber @bind-Value="AlbumToUpdate.Price" />
            </label>
        </div>

        <div>
            <button type="submit">Click to save changes</button>
        </div>

    </EditForm>
}

@if (replaceAlbumError)
{
    <p>Failed to replace album. Please try again later</p>
}
else if (showSuccess)
{
    <h3>Success! Updated Record:</h3>
    <RecordSummary Album="AlbumToUpdate"></RecordSummary>
}

@code {
    [Parameter]
    public Album? AlbumToUpdate { get; set; }

    private bool replaceAlbumError = false;
    private bool showSuccess = false;

    protected async Task HandleSave()
    {
        if (AlbumToUpdate != null)
        {
            replaceAlbumError = false;
            showSuccess = false;

            try
            {
                await _albumService.ReplaceAlbumByIdAsync(AlbumToUpdate!, AlbumToUpdate!.Id);

                showSuccess = true;
            }
            catch
            {
                replaceAlbumError = true;
            }
        }
    }
}
