@using Models
@using Services
@using RecordShop.Web.Components.Shared
@inject IAlbumService _albumService
@rendermode InteractiveServer

@if (AlbumToUpdate != null)
{
    <EditForm Model="AlbumToUpdate" OnValidSubmit="HandleSave" FormName="EditAlbumForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>
                Title: 
                <InputText @bind-Value="AlbumToUpdate.Title" />
            </label>
        </div>

        <div>
            <label>
                Description:
                <InputText @bind-Value="AlbumToUpdate.Description" />
            </label>
        </div>

        <div>
            <label>
                Release Date:
                <InputDate @bind-Value="AlbumToUpdate.ReleaseDate" />
            </label>
        </div>

        <div>
            <label>
                Price:
                <InputNumber @bind-Value="AlbumToUpdate.Price" />
            </label>
        </div>

        <button type="submit">Save Changes</button>
    </EditForm>
}

@if (error != null)
{
    <p>@error</p>
}

@code {
    [Parameter]
    public Album? AlbumToUpdate { get; set; }

    [Parameter]
    public EventCallback<Album> OnAlbumUpdated { get; set; }

    private Album? originalAlbum;
    private string? error;

    protected override void OnParametersSet()
    {
        if (AlbumToUpdate != null)
        {
            originalAlbum = new Album
            {
                Title = AlbumToUpdate.Title,
                Description = AlbumToUpdate.Description,
                ReleaseDate = AlbumToUpdate.ReleaseDate,
                Price = AlbumToUpdate.Price
            };
            error = null;
        }
    }

    private async Task HandleSave()
    {
        error = null;

        if (!HasChanges())
        {
            error = "No changes detected, please update something";
            await Task.Delay(2000);
            error = null;
            return;
        }

        try
        {
            await _albumService.ReplaceAlbumByIdAsync(AlbumToUpdate!, AlbumToUpdate!.Id);
            await OnAlbumUpdated.InvokeAsync(AlbumToUpdate);
        }
        catch
        {
            error = "Failed to save album. Please try again later.";
        }
    }

    private bool HasChanges() =>
        AlbumToUpdate?.Title != originalAlbum?.Title ||
        AlbumToUpdate?.Description != originalAlbum?.Description ||
        AlbumToUpdate?.ReleaseDate != originalAlbum?.ReleaseDate ||
        AlbumToUpdate?.Price != originalAlbum?.Price;
}
