@using Models;

<div class="card">
    <DeleteAlbumButton Id="Id"></DeleteAlbumButton>
    <UpdateForm AlbumToUpdate="Album" OnAlbumUpdated="OnAlbumUpdated"></UpdateForm>
</div>

@code {
    [Parameter]
    public Album? Album { get; set; }

    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public EventCallback<Album> OnAlbumUpdated { get; set; }
}
