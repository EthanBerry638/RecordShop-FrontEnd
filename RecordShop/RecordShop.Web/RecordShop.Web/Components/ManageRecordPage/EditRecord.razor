@using Models;

<div class="card">
    <DeleteAlbumButton Id="Id"></DeleteAlbumButton>
    <UpdateForm AlbumToUpdate="Album" OnAlbumUpdated="PassUpdatedAlbum"></UpdateForm>
</div>

@code {
    [Parameter]
    public Album? Album { get; set; }

    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public EventCallback<Album> OnAlbumUpdated { get; set; }

    private async Task PassUpdatedAlbum(Album updatedAlbum)
    {
        await OnAlbumUpdated.InvokeAsync(updatedAlbum);
    }
}
