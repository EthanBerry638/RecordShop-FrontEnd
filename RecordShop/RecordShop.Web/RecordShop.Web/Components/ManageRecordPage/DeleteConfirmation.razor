@rendermode InteractiveServer

<div class="card">
    <h3>Confirm Deletion?</h3>
    <button @onclick="() => ButtonClick(true)">Yes, delete</button>
    <button @onclick="() => ButtonClick(false)">No, don't delete</button>
</div>

@code {
    [Parameter]
    public EventCallback<bool> ConfirmChange { get; set; }

    private async Task ButtonClick(bool confirmed)
    {
        await ConfirmChange.InvokeAsync(confirmed);
    }
}