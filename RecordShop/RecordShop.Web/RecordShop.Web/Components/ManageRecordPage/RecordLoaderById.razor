@using System.Text.Json
@using System.Text.Json.Serialization
@using Models;
@using RecordShop.Web.Components.Shared
@using Services
@inject IAlbumService _albumService
@rendermode InteractiveServer

@if(getAlbumsError)
{
    <p>Failed to load record data. Please try again later.</p>
}
else if (album == null)
{
    <h2>Fetching Data...</h2>
    <Spinner Color="SpinnerColor.Primary" />
}
else
{
    @ChildContent(album);
}

@code {
    [Parameter]
    public int Id { get; set; }

    [Parameter] public RenderFragment<Album>? ChildContent { get; set; }

    private Album? album = null;
    private bool getAlbumsError;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var response = await _albumService.GetAlbumByIdAsync(Id);

            if (response != null)
            {
                album = response;
            }
            else
            {
                getAlbumsError = true;
            }
        }
        catch (Exception)
        {
            getAlbumsError = true;
        }
    }
}