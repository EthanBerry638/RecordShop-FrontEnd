@using Models;

<h3>Record Details</h3>

@if (AlbumToUpdate != null)
{
    <EditForm Model="AlbumToUpdate">
        <div>
            <label>
                Title: 
                <InputText @bind-Value="AlbumToUpdate.Title"/>
            </label>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Album? AlbumToUpdate { get; set; }
}
