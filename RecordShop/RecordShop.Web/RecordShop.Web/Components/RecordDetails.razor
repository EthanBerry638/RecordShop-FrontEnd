@using Models;
@rendermode InteractiveServer
@inject HttpClient Http

<h3>Current Record Details: </h3>

@if (AlbumToUpdate != null)
{
    <EditForm Model="AlbumToUpdate" OnValidSubmit="HandleSave" FormName="EditAlbumForm">
    <DataAnnotationsValidator/>
    <ValidationSummary/>

        <div>
            <label>
                Title: 
                <InputText @bind-Value="AlbumToUpdate.Title"/>
            </label>
        </div>

        <div>
            <label>
                Description:
                <InputText @bind-Value="AlbumToUpdate.Description" />
            </label>
        </div>

        <div>
            <label>
                Release Date:
                <InputDate @bind-Value="AlbumToUpdate.ReleaseDate" />
            </label>
        </div>

        <div>
            <label>
                Price:
                <InputNumber @bind-Value="AlbumToUpdate.Price" />
            </label>
        </div>

        <div>
            <button type="submit">Click to save changes</button>
        </div>

    </EditForm>
}

@if(updatedRecord != null)
{
    <h2>Updated Album Details: </h2>
    <ul>
        <li>Id: @Id</li>
        <li>Title: @updatedRecord.Title</li>
        <li>Description: @updatedRecord.Description</li>
        @if(updatedRecord.ReleaseDate != null)
        {
            <li>Release Date: @updatedRecord.ReleaseDate</li>
        }
        <li>Price: £@updatedRecord.Price</li>
    </ul>
}

@code {
    [Parameter]
    public Album? AlbumToUpdate { get; set; }

    [Parameter]
    public int Id { get; set; }

    private Album? updatedRecord;

    protected async Task HandleSave()
    {
        if (AlbumToUpdate != null)
        {
            updatedRecord = new Album()
            {
                Id = AlbumToUpdate.Id,
                Title = AlbumToUpdate.Title,
                Description = AlbumToUpdate.Description,
                ReleaseDate = AlbumToUpdate.ReleaseDate,
                Price = AlbumToUpdate.Price
            };
        }

        await Http.PutAsJsonAsync($"https://localhost:7091/api/Album/{Id}", updatedRecord);
    }
}
