@using System.Text.Json
@using System.Text.Json.Serialization
@using Models;
@rendermode InteractiveServer
@inject HttpClient Http

@if(getAlbumsError)
{
    <p>Failed to load record data. Please try again later.</p>
}
else if (album == null)
{
    <h2>Fetching Data...</h2>
    <Spinner Color="SpinnerColor.Primary" />
}
else
{
    <RecordSummary Album="album"></RecordSummary>
    <RecordDetails Id="@Id" AlbumToUpdate="album"></RecordDetails>
    <DeleteAlbum></DeleteAlbum>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Album? album = null;
    private bool getAlbumsError;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<Album>($"https://localhost:7091/api/Album/{Id}");

            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            if (response != null)
            {
                album = response;
            }
            else
            {
                getAlbumsError = true;
            }
        }
        catch (Exception)
        {
            getAlbumsError = true;
        }
    }
}