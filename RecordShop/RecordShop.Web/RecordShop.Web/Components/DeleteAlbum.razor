@using Models;
@rendermode InteractiveServer
@inject HttpClient Http

<button @onclick="HandleDeletion">🗑️</button>

@code {
    [Parameter]
    public Album? Album { get; set; }

    private bool isDeleted = false;

    private async Task HandleDeletion()
    {
        try
        {
            var response = await Http.DeleteAsync($"https://localhost:7091/api/Albums/{Album!.Id}");
        }
        catch (Exception)
        {
            isDeleted = false;
        }
    }
}