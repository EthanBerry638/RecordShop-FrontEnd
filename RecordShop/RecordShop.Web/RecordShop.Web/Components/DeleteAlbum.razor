@using Models;
@rendermode InteractiveServer
@inject HttpClient Http

<button @onclick="HandleDeletion">🗑️</button>

@if (isDeleted)
{
    <p>@Album.Title was deleted</p>
}
else if (!isDeleted && isClicked)
{
    <p>Failed to delete. Please try again later or refresh</p>
}

@code {
    [Parameter]
    public Album? Album { get; set; }

    private bool isDeleted = false;
    private bool isClicked = false;

    private async Task HandleDeletion()
    {
        isClicked = true;
        try
        {
            var response = await Http.DeleteAsync($"https://localhost:7091/api/Album/{Album!.Id}");

            if (response.IsSuccessStatusCode)
            {
                isDeleted = true;
            }
            else
            {
                isDeleted = false;
            }
        }
        catch (Exception)
        {
            isDeleted = false;
        }
    }
}